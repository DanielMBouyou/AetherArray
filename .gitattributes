# Line ending normalisation.
# The repository stores LF for every text file, whatever system it was written on.

* text=auto

# These files are run by continuous integration on Linux: they must stay LF even
# in a Windows working copy.
*.sh text eol=lf
*.yml text eol=lf

# Generated documents and images are binary: never converted, never diffed as text.
# The runbook PDFs are built from their Markdown sources, docs/runbooks/README.md.
*.pdf binary
*.png binary
